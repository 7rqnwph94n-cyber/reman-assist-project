# Reman Assistant - environment variables (copy and edit)

# Required for pilot/production
FLASK_ENV=production
FLASK_CONFIG=production
APP_ENV=production
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/reman
# If SQLite is used in pilot/prod, DATABASE_URL must be absolute:
# DATABASE_URL=sqlite:////absolute/path/to/app.db
REDIS_URL=redis://host:6379/0
REQUIRE_REDIS=1
UPLOAD_FOLDER=/path/to/uploads
LOG_FILE=/path/to/logs/app.log
PDF_EXTRACTOR_PROFILES_DIR=/path/to/pdf-parts-extractor/profiles
MAX_CONTENT_LENGTH_MB=500
MAX_FORM_MEMORY_MB=500
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
REGION=UK
LOCALE=en_GB
CURRENCY=GBP

# Optional
LOG_FORMAT=json
LOG_LEVEL=INFO
CHECK_SCHEMA_ON_STARTUP=1
CHECK_MIGRATIONS_ON_STARTUP=1
CHECK_REDIS_ON_STARTUP=1
SESSION_COOKIE_SECURE=1
ENABLE_DEV_TOOLS=0
DEMO_RESET_ENABLED=0

# QuickBooks Online Integration (optional)
# Get these from https://developer.intuit.com
ENABLE_QUICKBOOKS=0
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://yourdomain.com/admin/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QB_ENCRYPTION_KEY=
